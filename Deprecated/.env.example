# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ohana_ai"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Storage (optional)
# Defaults store data under the project directory (or /tmp on Vercel).
# Set STORAGE_ROOT to an absolute path (e.g., /Volumes/OhanaData) to use an external drive.
# STORAGE_MODE: local | blob | hybrid (local + blob). Default is local; on Vercel, default is blob.
# BLOB_READ_WRITE_TOKEN is required to write to Vercel Blob.
STORAGE_ROOT=""
UPLOADS_DIR=""
TRAINING_DATA_DIR=""
ML_EXPORTS_DIR=""
STORAGE_MODE="local"
BLOB_READ_WRITE_TOKEN=""
BLOB_PREFIX="uploads"
SYNC_GEDCOM_PROCESSING=true
PREDICTION_CONFIDENCE_THRESHOLD=0.4
PREDICTION_MAX_SUGGESTIONS=5

# ML Training Data Export
EXPORT_SECRET="your-export-secret-here"
ML_EXPORT_API_KEY="your-ml-export-api-key"
TRAINING_COMMAND="python3"
TRAINING_ARGS="train_model_mlx.py --data-dir training_data"

# Vercel (for deployment)
VERCEL_URL="your-vercel-url.vercel.app"

# Email SMTP (local hosting)
# Use Gmail SMTP (requires App Password) or a free SMTP provider (e.g., Brevo)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Ohana AI <no-reply@local>"
ADMIN_EMAIL=

# ML auto-train (optional)
AUTO_TRAIN=false
TRAINING_SCRIPT=train_model_mlx.py
